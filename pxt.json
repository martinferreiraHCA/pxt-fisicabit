{
    "name": "fisicabit-sensores",
    "version": "0.9.1",
    "description": "Extensión micro:bit para experimentos de física: sensores, barreras ópticas y envío de datos a fisicabit.com con un solo bloque por USB o Bluetooth",
    "license": "MIT",
    "authors": [
        "FisicaBit"
    ],
    "public": true,
    "dependencies": {
        "core": "*",
        "bluetooth": "*",
        "microphone": "*"
    },
    "files": [
        "README.md",
        "fisicabit.ts",
        "cinematica.ts",
        "fisicabit_datos.ts",
        "serial_sensores.ts",
        "bluetooth_sensores.ts",
        "tof_sensores.ts",
        "enums.d.ts",
        "shims.d.ts",
        "shims.cpp",
        "tcs3200_sensores.ts",
        "bme280_sensores.ts",
        "dht11_sensores.ts",
        "ds18b20_sensores.ts",
        "hcsr04_sensores.ts",
        "audio_shims.ts",
        "sonido_sensores.ts",
        "hx711_sensores.ts",
        "_locales/es/fisicabit-sensores-strings.json",
        "_locales/es/fisicabit-sensores-jsdoc-strings.json",
        "_locales/en/fisicabit-sensores-strings.json",
        "_locales/en/fisicabit-sensores-jsdoc-strings.json",
        "_locales/pt-BR/fisicabit-sensores-strings.json",
        "_locales/pt-BR/fisicabit-sensores-jsdoc-strings.json",
        "tutorial-usb.md",
        "tutorial-bluetooth.md",
        "_locales/es/tutorial-usb.md",
        "_locales/es/tutorial-bluetooth.md",
        "_locales/pt-BR/tutorial-usb.md",
        "_locales/pt-BR/tutorial-bluetooth.md"
    ],
    "testFiles": [
        "test.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "configIsJustDefaults": true,
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 1,
                    "whitelist": 0,
                    "security_level": null
                }
            }
        }
    }
}
